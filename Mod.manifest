[mod_information]

name="Hev's More Minerals"
id="hev.MoreMinerals"
description="MOREMINERALS_MOD_DESCRIPTION"
brief="MOREMINERALS_MOD_BRIEF"
author="__hev"
credits=PoolStringArray( "MOREMINERALS_CREDITS_CONTRIBUTORS_HEADER", "MOREMINERALS_CREDITS_CONTRIBUTORS_TYLEANSIN", "MOREMINERALS_CREDITS_CONTRIBUTORS_ZAKRIN", "", "HEVLIB_CREDITS_TRANSLATORS_HEADER", "HEVLIB_CREDITS_TRANSLATORS_1WT1", "HEVLIB_CREDITS_TRANSLATORS_HEDRAUTA", "", "HEVLIB_CREDITS_SUPPORTERS_HEADER", "HEVLIB_CREDITS_SUPPORTERS_KOFI_GAZI", "HEVLIB_CREDITS_SUPPORTERS_KOFI_BAGGERDUDE", "HEVLIB_CREDITS_SUPPORTERS_KOFI_1WT1", "HEVLIB_CREDITS_SUPPORTERS_KOFI_TESSIER" )

[version]

version_major=1
version_minor=6
version_bugfix=0

[tags]

TAG_ALLOW_ACHIEVEMENTS={
"type": "bool",
"value": true
}
TAG_OVERHAUL={
"type": "bool",
"value": true
}
TAG_QOL={
"type": "bool",
"value": true
}
