"type": "array",
"value": [ "Adds lots of new minerals" ]
}
TAG_ADD_TRANSIT_TIPS={
"type": "array",
"value": [ "MOREMINERALS_TRANSIT_TIPS_1", "MOREMINERALS_TRANSIT_TIPS_2" ]
}

[links]

HEVLIB_DISCORD={
